# ---- Database (required) ----
# Get a free Postgres instance from Supabase (supabase.com) or Neon (neon.tech).
# Copy the "connection string" they give you (starts with postgresql://)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Server ----
PORT=3000

# ---- Email for daily reports (required for alerts) ----
# Easiest: a Gmail address with an "App Password" (not your normal password) —
# Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
REPORT_FROM_EMAIL=youraddress@gmail.com
REPORT_TO_EMAIL=youraddress@gmail.com

# Hour (0-23, server local time) the daily report auto-sends. Set TZ so this means what you think it means.
REPORT_HOUR=8
TZ=Asia/Kolkata
